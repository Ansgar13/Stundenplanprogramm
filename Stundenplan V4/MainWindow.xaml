<Window x:Class="Stundenplan_V2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stundenplan V2"
        Height="1000"
        Width="820"
        MinHeight="700"
        MinWidth="760"
        FontSize="15"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Stundenplan-Generator" FontSize="23"
                       FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TxtDatei" Text="Keine Datei geladen" FontSize="17"
                       FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Buttons: schmaler, zweispaltig statt einer langen Reihe -> gibt dem
             Meldefenster (TxtLog) darunter deutlich mehr Platz. -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Padding" Value="6,9"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Grid.Column="0" Content="1. Excel-Datei einlesen" Margin="0,0,6,10" Click="BtnPfad_Click"/>
            <Button Grid.Row="0" Grid.Column="1" Content="2. Zeitwünsche einlesen/exportieren" Margin="6,0,0,10" Click="BtnZeitwuensche_Click"/>

            <Button Grid.Row="1" Grid.Column="0" Content="3. Gezielt ignorieren" Margin="0,0,6,10" Click="BtnIgnorieren_Click"/>
            <Button Grid.Row="1" Grid.Column="1" Content="4. Gezielt fixieren" Margin="6,0,0,10" Click="BtnFixieren_Click"/>

            <Button Grid.Row="2" Grid.Column="0" Content="5. UNr-Plan bewerten" Margin="0,0,6,10" Click="BtnUnrPlan_Click"/>
            <Button Grid.Row="2" Grid.Column="1" Content="6. UNr-Plan prüfen (Verletzungen)" Margin="6,0,0,10" Click="BtnPlanPrüfen_Click"/>

            <Button Grid.Row="3" Grid.Column="0" Content="7. Stundenplanerstellung" Margin="0,0,6,10" Click="BtnSchritt2_Click"/>
            <Button Grid.Row="3" Grid.Column="1" Content="8. Plan-Editor (interaktiv)" Margin="6,0,0,10" Click="BtnPlanEditor_Click"/>

            <Button Grid.Row="4" Grid.Column="0" Content="9. Lösung sichern" Margin="0,0,6,10" Click="BtnLoesungSichern_Click"/>
            <Button Grid.Row="4" Grid.Column="1" Content="10. Gesicherte Lösung löschen" Margin="6,0,0,10" Click="BtnGesicherteLoesungLoeschen_Click"/>

            <Button Grid.Row="5" Grid.Column="0" Content="11. Plan verbessern" Margin="0,0,6,10" Click="BtnPlanVerbessern_Click"/>
            <Button Grid.Row="5" Grid.Column="1" Content="12. Minimale Änderungen (Solver)" Margin="6,0,0,10" Click="BtnMinimalAenderung_Click"/>

            <Button Grid.Row="6" Grid.Column="0" Content="13. Fix/Lösung → Plan exportieren" Margin="0,0,6,10" Click="BtnFixExport_Click"/>
            <Button Grid.Row="6" Grid.Column="1" Content="14. Diagnose an Diag anhängen" Margin="6,0,0,10" Click="BtnDiagAnhaengen_Click"/>

            <Button Grid.Row="7" Grid.Column="0" Content="15. Klassenpläne erzeugen" Margin="0,0,6,10" Click="BtnKlassenplaene_Click"/>
            <Button Grid.Row="7" Grid.Column="1" Content="15b. Klassenpläne EF / Q1 / Q2" Margin="6,0,0,10" Click="BtnKlassenplaeneOberstufe_Click"/>

            <Button Grid.Row="8" Grid.Column="0" Content="16. Lehrerpläne erzeugen" Margin="0,0,6,10" Click="BtnLehrerplaene_Click"/>
            <Button Grid.Row="8" Grid.Column="1" Content="17. PM-Parameter bearbeiten" Margin="6,0,0,10" Click="BtnPmBearbeiten_Click"/>

            <Button Grid.Row="9" Grid.Column="0" Content="18. UV als GPU002.TXT exportieren" Margin="0,0,6,10" Click="BtnGpuExport_Click"/>
            <Button Grid.Row="9" Grid.Column="1" Content="19. GPU002.TXT in UV importieren" Margin="6,0,0,10" Click="BtnGpuImport_Click"/>
        </Grid>

        <!-- Meldefenster (Protokoll-Log): bekommt durch die zweispaltigen Buttons
             oben jetzt deutlich mehr Höhe (Row="*" statt vieler Auto-Button-Zeilen). -->
        <TextBox x:Name="TxtLog" Grid.Row="2" Margin="0,0,0,10"
                 FontSize="15"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                 IsReadOnly="True" FontFamily="Consolas"/>

        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" CornerRadius="5">
            <TextBlock x:Name="TxtStatus" Text="Bereit." FontSize="15" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
