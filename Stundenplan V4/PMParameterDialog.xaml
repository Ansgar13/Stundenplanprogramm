<Window x:Class="Stundenplan_V2.PMParameterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PM-Parameter bearbeiten"
        Width="620" Height="640"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" TextWrapping="Wrap"
                    Text="Alle Zeilen der Tabelle 'PM' (Spalte A = Parameter, Spalte B = Wert). Werte direkt in der Spalte 'Wert' bearbeiten und speichern — die Excel-Datei wird danach automatisch neu eingelesen und das Fenster schließt sich."/>

        <DataGrid x:Name="DgParameter" Grid.Row="1"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter (Spalte A)" Binding="{Binding Beschriftung}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Wert (Spalte B)" Binding="{Binding Wert, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nur ein Button: Änderungen werden nie verworfen, gespeichert wird
             immer. Schließen erledigt der Speichern-Vorgang selbst (siehe
             BtnSpeichern_Click). -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSpeichern" Content="Speichern und schließen" Width="180"
                    Click="BtnSpeichern_Click"/>
        </StackPanel>
    </Grid>
</Window>
